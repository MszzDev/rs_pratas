<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          Ser a tela inicial do tablet é uma condição que LIGA E DESLIGA.

          Antes, o filtro de HOME ficava direto na activity, e por isso era
          permanente: mesmo depois de sair do quiosque e limpar a preferência,
          o aplicativo continuava candidato a tela inicial. O Android voltava a
          perguntar qual usar, lembrava a escolha, e o tablet "liberado"
          seguia se comportando como caixa.

          Num apelido separado, desligado por padrão, a condição vira algo que
          o aplicativo controla: liga ao entrar no quiosque, desliga ao sair.
          Fora do quiosque ele nem aparece na lista de candidatos — é um
          aplicativo comum, como o dono pediu.
        -->
        <activity-alias
            android:name=".TelaInicial"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity-alias>

        <!--
          Endereço que o comando de provisionamento procura:

            adb shell dpm set-device-owner com.rspratas.app/.KioskDeviceAdminReceiver

          Sem esta declaração o comando falha dizendo que o componente não
          existe — mesmo com a classe compilada no aplicativo.
        -->
        <receiver
            android:name=".KioskDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Volta ao PDV sozinho depois que o tablet reinicia. Sem isto, uma queda de
      energia deixaria o aparelho na tela de bloqueio esperando alguém abrir o
      aplicativo — e quem abre a loja de manhã não é quem instalou o sistema.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      A impressora térmica do balcão, por Bluetooth clássico.

      Duas idades do Android convivem aqui. Até o 11, conectar era permissão de
      instalação (BLUETOOTH/BLUETOOTH_ADMIN) e ninguém perguntava nada. Do 12
      em diante virou permissão de tempo de execução (BLUETOOTH_CONNECT), e o
      aplicativo tem que pedir.

      `neverForLocation` diz ao Android que não usamos Bluetooth para descobrir
      onde o aparelho está — sem isso o sistema exigiria permissão de
      localização para imprimir um comprovante, o que ninguém entenderia.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation" />

    <!--
      Impressora ligada no cabo.

      `required=false` de proposito: nem todo tablet tem porta USB util, e a
      loja que imprime por Bluetooth ou por rede nao deve ficar sem instalar o
      aplicativo por causa de uma porta que ela nao usa.
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />
</manifest>
