NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# docker-compose.yml (raiz do repo) sobe Postgres na porta 5434 (não 5432 — evita
# colidir com outros projetos Postgres locais). Role de runtime (app_rw): SEM
# UPDATE/DELETE em audit_logs e time_clock_entries — ver migração de lock.
DATABASE_URL=postgresql://app_rw:CHANGE_ME@localhost:5434/rs_pratas_fase1
# Role de owner (app_owner): usada só por `prisma migrate deploy` em CI/CD.
DATABASE_MIGRATE_URL=postgresql://app_owner:CHANGE_ME@localhost:5434/rs_pratas_fase1

REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_BYTES
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=rs-pratas-api

STEP_UP_TOKEN_TTL=5m

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

TOTP_ISSUER=RS Pratas
TOTP_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

CORS_ALLOWED_ORIGINS=https://app.rspratas.com.br,capacitor://localhost,http://localhost:5173

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
