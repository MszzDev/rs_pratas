generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum UserRole {
  VENDEDOR
  GERENTE
  DONO
  DESENVOLVEDOR
}

enum UserStatus {
  PENDING_FIRST_ACCESS
  ACTIVE
  BLOCKED
  INACTIVE
}

enum DeviceType {
  TABLET
  DESKTOP
  MOBILE
}

enum DeviceStatus {
  PENDING // criado, aguardando claim do pairingCode
  ACTIVE
  BLOCKED
  UNLINKED
  RETIRED
}

enum PaymentTerminalStatus {
  PENDING
  ACTIVE
  BLOCKED
  RETIRED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum StepUpPurpose {
  CREATE_OR_PROMOTE_OWNER
  CHANGE_INTEGRATION_CREDENTIAL
  UNLINK_DEVICE
  EXIT_KIOSK
  CHANGE_PERMISSIONS
  CHANGE_COST
  REFUND_LARGE
  DEACTIVATE_STORE
  EXPORT_SENSITIVE_DATA
  TWO_FACTOR_DISABLE
}

enum TimeClockEventType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

