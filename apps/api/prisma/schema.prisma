  DEVICE_PAIR_INITIATED
  DEVICE_PAIR_CLAIMED
  DEVICE_UPDATE
  DEVICE_UNLINK
  DEVICE_BLOCK
  DEVICE_KIOSK_EXIT
  SESSION_REVOKE
  SESSION_REVOKE_ALL
  SESSION_REUSE_DETECTED
  STORE_CREATE
  STORE_UPDATE
  STORE_DEACTIVATE
  COMPANY_UPDATE
  DATA_EXPORT
  TIMECLOCK_ENTRY_CREATE
  TIMECLOCK_CORRECTION
  WORK_SCHEDULE_CREATE
  WORK_SCHEDULE_UPDATE
  TWO_FACTOR_SETUP_STARTED
  TWO_FACTOR_ENABLE
  TWO_FACTOR_DISABLE
  TWO_FACTOR_CHALLENGE_FAILED
  TWO_FACTOR_RECOVERY_USED
  STEP_UP_ISSUED
  STEP_UP_FAILED
  SETTING_UPDATE
  PERMISSION_DENIED
  CATEGORY_CREATE
  CATEGORY_UPDATE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DEACTIVATE
  PRODUCT_PRICE_CHANGE
  STOCK_MOVEMENT
  STOCK_ADJUST
  STOCK_TRANSFER_CREATE
  STOCK_TRANSFER_SEND
  STOCK_TRANSFER_RECEIVE
  STOCK_TRANSFER_CANCEL
  INVENTORY_OPEN
  INVENTORY_COUNT
  INVENTORY_CLOSE
  CUSTOMER_CREATE
  CUSTOMER_UPDATE
  CASH_OPEN
  CASH_CLOSE
  CASH_WITHDRAWAL
  CASH_SUPPLY
  SALE_COMPLETE
