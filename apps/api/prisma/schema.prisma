// =====================================================================
// TENANT / IDENTIDADE
// =====================================================================

model Company {
  id        String  @id @default(uuid())
  legalName String
  tradeName String
  cnpj      String  @unique
  email     String?
  phone     String?
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stores       Store[]
  users        User[]
  auditLogs    AuditLog[]
  appSettings  AppSetting[]
  integrations Integration[]

  categories      Category[]
  sizeGrades      SizeGrade[]
  products        Product[]
  stockTransfers  StockTransfer[]
  inventories     Inventory[]
  customers       Customer[]
  labelTemplates  LabelTemplate[]
  commissionRules CommissionRule[]
  goals           Goal[]
  pieceRequests   PieceRequest[]

  @@map("companies")
}

model Store {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code        String // código curto interno, ex: "MTZ", "SH01"
  name        String
  cnpj        String?
  timezone    String  @default("America/Sao_Paulo")
  phone       String?
  /// Contato da loja — vai no comprovante para o cliente saber onde reclamar.
  email       String?
  addressJson Json?
  /// Cadastro ativo — a loja existe. Diferente de estar ABERTA agora.
  isActive    Boolean @default(true)

  /// Loja aberta neste momento.
  ///
  /// Abre sozinha quando alguém entra por PIN num tablet dela — o funcionário
  /// chegou e ligou o tablet, a loja está funcionando. Não faz sentido pedir
  /// que alguém aperte "abrir loja" depois de já ter passado o PIN.
  ///
  /// O dono abre e fecha qualquer loja de onde estiver, e é ele quem fecha no
  /// fim do dia: deixar a loja fechar sozinha por inatividade esconderia o
  /// tablet que ficou ligado a noite toda.
  /// Horário ANUNCIADO da loja, por dia da semana mais feriado.
  ///
  /// Não se confunde com `isOpen`, que diz se ela está aberta agora: um é o
  /// que a placa na porta promete, o outro é o que o tablet registrou. Serve
  /// para o comprovante, para responder "abre segunda?" sem ligar para a loja,
  /// e para já preencher a jornada de quem for cadastrado ali.
  openingHours     Json?

  isOpen           Boolean   @default(false)
  openedAt         DateTime?
  openedById       String?
  openedBy         User?     @relation("StoreOpenedBy", fields: [openedById], references: [id])
  /// Tablet cujo login abriu a loja. Nulo quando o dono abriu manualmente.
  openedByDeviceId String?
  closedAt         DateTime?
  closedById       String?
  closedBy         User?     @relation("StoreClosedBy", fields: [closedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  posStations      POSStation[]
  userStores       UserStore[]
  devices          Device[]
  workSchedules    WorkSchedule[]
  timeClockEntries TimeClockEntry[]
  storeSettings    StoreSetting[]
  auditLogs        AuditLog[]

  stockItems        StockItem[]
  transfersSent     StockTransfer[] @relation("TransferOrigin")
  transfersReceived StockTransfer[] @relation("TransferDestination")
  inventories       Inventory[]

  cashSessions    CashSession[]
  sales           Sale[]
  reservations    Reservation[]
  quotes          Quote[]
  printJobs       PrintJob[]
  commissionRules CommissionRule[]
  goals           Goal[]
  saleReturns     SaleReturn[]
  serviceOrders   ServiceOrder[]
  pieceRequests   PieceRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("stores")
}

model User {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Matrícula: a ÚNICA identidade de login. O e-mail abaixo nunca autentica.
  employeeCode String
  /// CPF, só dígitos. Opcional no cadastro porque a loja contrata antes de ter
  /// o documento em mãos, mas OBRIGATÓRIO para o AFD: é por ele que a
  /// fiscalização identifica o trabalhador no arquivo do ponto.
  cpf          String?
  /// Canal de contato — envio de credenciais e documentos. Não serve para login:
  /// separar identidade de canal evita que uma caixa de e-mail comprometida
  /// vire acesso ao caixa da loja.
  email        String?
  name         String
  role         UserRole
  status       UserStatus @default(PENDING_FIRST_ACCESS)

  passwordHash       String? // argon2id — null até 1º acesso concluído
  pinHash            String? // argon2id — null até PIN criado
  /// Quando o PIN foi definido pela ultima vez. O PIN vence a cada 30 dias:
  /// ele abre o caixa e bate o ponto num tablet compartilhado, entao um PIN
  /// que nunca muda vira senha coletiva.
  pinChangedAt       DateTime?
  mustChangePassword Boolean   @default(true)
  mustCreatePin      Boolean   @default(true)

  passwordFailedAttempts Int       @default(0)
  passwordLockedUntil    DateTime?
  pinFailedAttempts      Int       @default(0)
  pinLockedUntil         DateTime?

  lastLoginAt DateTime?

  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userStores           UserStore[]
  deviceSessions       DeviceSession[]
  twoFactorCredential  TwoFactorCredential?
  stepUpTokens         StepUpToken[]
  workSchedules        WorkSchedule[]       @relation("WorkScheduleUser")
  workSchedulesCreated WorkSchedule[]       @relation("WorkScheduleCreatedBy")
  timeClockEntries     TimeClockEntry[]
  auditLogs            AuditLog[]

  permissionOverrides UserPermission[] @relation("UserPermissionUser")
  permissionsGranted  UserPermission[] @relation("UserPermissionGrantedBy")
  permissionsRevoked  UserPermission[] @relation("UserPermissionRevokedBy")

  devicesPaired   Device[]        @relation("DevicePairedBy")
  sessionsRevoked DeviceSession[] @relation("DeviceSessionRevokedBy")

  appSettingsUpdated    AppSetting[]
  storeSettingsUpdated  StoreSetting[]
  deviceSettingsUpdated DeviceSetting[]

  documents         EmployeeDocument[] @relation("EmployeeDocumentOwner")
  documentsReviewed EmployeeDocument[] @relation("EmployeeDocumentReviewer")

  stockMovements StockMovement[]

  storesOpened         Store[]           @relation("StoreOpenedBy")
  storesClosed         Store[]           @relation("StoreClosedBy")
  cashSessionsOpened   CashSession[]     @relation("CashSessionOpenedBy")
  cashSessionsClosed   CashSession[]     @relation("CashSessionClosedBy")
  cashMovements        CashMovement[]
  salesMade            Sale[]            @relation("SaleSeller")
  saleDiscountsAllowed Sale[]            @relation("SaleDiscountAuthorizer")
  printJobsRequested   PrintJob[]
  commissionRules      CommissionRule[]
  goals                Goal[]
  pieceRequestsCreated PieceRequest[]    @relation("PieceRequestCreatedBy")
  PinResetRequest      PinResetRequest[]

  @@unique([companyId, employeeCode])
  /// O mesmo CPF não pode aparecer em duas matrículas da empresa — seria a
  /// mesma pessoa com duas jornadas no AFD.
  ///
  /// Aqui o NULL-distinto do Postgres joga a favor: vários funcionários ainda
  /// sem CPF cadastrado convivem sem colidir, e só os preenchidos são
  /// comparados. (Em outros pontos do schema foi preciso índice PARCIAL para
  /// obter o efeito contrário — ali dois NULLs precisavam colidir.)
  @@unique([companyId, cpf], map: "users_company_cpf_key")
  @@index([companyId, role])
  @@map("users")
}

model UserStore {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("user_stores")
}

// =====================================================================
// RBAC — Role / Permission / UserPermission
// =====================================================================

model Role {
  id          String   @id @default(uuid())
  code        UserRole @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // ex: "USER_CREATE", "STOCK_ADJUST", "AUDIT_VIEW_ALL"
  category    String // ex: "USER", "STORE", "DEVICE", "TIMECLOCK", "FINANCE", "SECURITY"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation("UserPermissionUser", fields: [userId], references: [id])
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id])
  effect       PermissionEffect // ALLOW ou DENY — DENY sempre vence sobre Role default
  reason       String?
  expiresAt    DateTime?

  grantedById String
  grantedBy   User   @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id])

  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("UserPermissionRevokedBy", fields: [revokedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// =====================================================================
// HIERARQUIA DE DISPOSITIVOS
// Company -> Store -> POSStation -> CashRegister -> Device -> PaymentTerminal
// =====================================================================

model POSStation {
  id       String  @id @default(uuid())
  storeId  String
  store    Store   @relation(fields: [storeId], references: [id])
  code     String
  name     String
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cashRegisters CashRegister[]

  @@unique([storeId, code])
  @@map("pos_stations")
}

/// Placeholder — abertura/fechamento de caixa vem em fase futura.
model CashRegister {
  id           String     @id @default(uuid())
  posStationId String
  posStation   POSStation @relation(fields: [posStationId], references: [id])
  code         String
  name         String
  isActive     Boolean    @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  devices      Device[]
  cashSessions CashSession[]

  @@unique([posStationId, code])
  @@map("cash_registers")
}

model Device {
  id             String       @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  // Denormalizado para performance de query e defesa em profundidade contra IDOR
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  type           DeviceType   @default(TABLET)
  name           String
  deviceUuid     String?      @unique // preenchido no claim do pairing
  model          String?
  osVersion      String?
  appVersion     String?
  status         DeviceStatus @default(PENDING)
  isKioskEnabled Boolean      @default(true)

  pairingCode          String?   @unique
  pairingCodeExpiresAt DateTime?

  pairedAt   DateTime?
  pairedById String?
  pairedBy   User?     @relation("DevicePairedBy", fields: [pairedById], references: [id])
  lastSeenAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  deviceSessions   DeviceSession[]
  timeClockEntries TimeClockEntry[]
  deviceSettings   DeviceSetting[]
  paymentTerminals PaymentTerminal[]

  @@index([storeId])
  @@index([cashRegisterId])
  @@map("devices")
}

/// Placeholder de fase futura — o FK chain precisa existir desde já.
/// Nenhum destes campos pode ser null: toda maquininha pertence obrigatoriamente
/// a loja + estação + caixa + tablet.
model PaymentTerminal {
  id             String @id @default(uuid())
  deviceId       String
  device         Device @relation(fields: [deviceId], references: [id])
  cashRegisterId String
  posStationId   String
  storeId        String
  companyId      String

  provider     String?
  serialNumber String?               @unique
  status       PaymentTerminalStatus @default(PENDING)

  /// A que o PDV oferece primeiro. As demais do mesmo caixa são reserva, para
  /// quando a principal fica sem sinal ou sem bateria no meio do expediente.
  /// O índice parcial abaixo garante uma só principal por caixa.
  isPrimary Boolean @default(false)

  /// Conta do Mercado Pago DESTA maquininha.
  ///
  /// Na prática cada aparelho está numa conta própria — foi assim que a loja
  /// contratou, e é assim que o dinheiro cai. Uma credencial só para a empresa
  /// inteira faria o sistema consultar a conta errada: o pagamento existiria na
  /// maquininha e "não seria encontrado" na conferência.
  ///
  /// Nulo enquanto a conta não for informada. A maquininha continua servindo
  /// para cobrar — só não dá para consultar nem estornar pelo sistema.
  mpAccountLabel       String?
  /// user_id da conta, respondido pelo próprio Mercado Pago ao testar o token.
  mpExternalAccountId  String?
  /// Identificador do aparelho na API do Point, escolhido pelo dono entre as
  /// maquininhas que a conta tem. É o que permite mandar o valor da venda
  /// direto para a tela dela, em vez de alguém digitar.
  mpDeviceId           String?
  /// AES-256-GCM. NUNCA sai da API — nem para o dono.
  credentialsEncrypted String?
  credentialsUpdatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deviceId])
  @@index([cashRegisterId])
  @@map("payment_terminals")
}

// =====================================================================
// AUTENTICAÇÃO / SESSÃO
// =====================================================================

model DeviceSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Null em login por senha fora de um tablet da loja (notebook/celular do dono
  /// ou gerente) — a especificação exige que o sistema também funcione nesses
  /// aparelhos, e eles não pertencem à cadeia loja→estação→caixa. O login por
  /// matrícula+PIN, ao contrário, SEMPRE exige um Device pareado e ACTIVE: o PIN
  /// tem entropia baixa demais para valer sozinho, e o tablet registrado é o
  /// segundo fator de fato.
  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id])

  companyId String
  storeId   String?

  ipAddress String?
  userAgent String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  revokedAt     DateTime?
  revokedReason String?
  revokedById   String?
  revokedBy     User?     @relation("DeviceSessionRevokedBy", fields: [revokedById], references: [id])

  refreshTokens RefreshToken[]
  stepUpTokens  StepUpToken[]

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("device_sessions")
}

model RefreshToken {
  id        String        @id @default(uuid())
  sessionId String
  session   DeviceSession @relation(fields: [sessionId], references: [id])

  tokenHash     String        @unique // SHA-256(token + pepper)
  rotatedFromId String?       @unique
  rotatedFrom   RefreshToken? @relation("RefreshTokenChain", fields: [rotatedFromId], references: [id])
  rotatedTo     RefreshToken? @relation("RefreshTokenChain")

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdByIp   String?

  @@index([sessionId])
  @@map("refresh_tokens")
}

model TwoFactorCredential {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  secretEncrypted String // AES-256-GCM, chave em TOTP_ENCRYPTION_KEY (secret manager)
  algorithm       String @default("SHA1") // compat Microsoft/Google Authenticator
  digits          Int    @default(6)
  period          Int    @default(30)

  recoveryCodesHash      String[] // cada item: argon2id de um código de recuperação
  recoveryCodesUsedCount Int      @default(0)

  confirmedAt  DateTime?
  lastUsedAt   DateTime?
  lastUsedStep BigInt? // anti-replay dentro da mesma janela de 30s

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("two_factor_credentials")
}

model StepUpToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  sessionId String
  session   DeviceSession @relation(fields: [sessionId], references: [id])

  purpose   StepUpPurpose
  method    String // "PASSWORD" | "TOTP" | "RECOVERY_CODE"
  tokenHash String        @unique

  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?

  @@index([userId, purpose, expiresAt])
  @@map("step_up_tokens")
}

// =====================================================================
// PONTO ELETRÔNICO OFICIAL (REP-P — Portaria MTP 671/2021)
// =====================================================================

model WorkSchedule {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation("WorkScheduleUser", fields: [userId], references: [id])
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  weekday          Weekday
  startTime        String // "08:00" (HH:mm, timezone da loja)
  endTime          String // "18:00"
  breakStartTime   String?
  breakEndTime     String?
  toleranceMinutes Int     @default(10)

  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdById String
  createdBy   User   @relation("WorkScheduleCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, weekday])
  @@map("work_schedules")
}

/// IMUTÁVEL — nenhuma linha é jamais alterada ou apagada (nem pelo dono).
/// Correção = novo registro com correctsEntryId apontando para o original.
model TimeClockEntry {
  id  String @id @default(uuid())
  nsr BigInt @unique @default(autoincrement()) // Número Sequencial de Registro (AFD)

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  companyId String
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  /// Nulo quando a marcação não partiu de um tablet pareado — o funcionário
  /// bateu do computador da loja ou do próprio celular. A loja continua
  /// obrigatória: é ela que identifica onde a jornada foi cumprida.
  deviceId  String?
  device    Device? @relation(fields: [deviceId], references: [id])

  type            TimeClockEventType
  timestamp       DateTime // horário de servidor, autoritativo
  clientTimestamp DateTime? // horário reportado pelo tablet, só para detecção de deriva

  isWithinTolerance Boolean? // calculado e congelado no momento da criação
  minutesLate       Int?

  justification        String? // obrigatória (validação de app) para saída durante turno
  justificationPending Boolean @default(false) // marcado quando type exige justificativa e ela não veio

  correctsEntryId  String?
  correctsEntry    TimeClockEntry?  @relation("TimeClockCorrection", fields: [correctsEntryId], references: [id])
  corrections      TimeClockEntry[] @relation("TimeClockCorrection")
  correctionReason String?

  sourceIp String?
  geoLat   Float?
  geoLng   Float?

  createdAt DateTime @default(now()) // único carimbo de tempo de linha — não há updatedAt de propósito

  @@index([userId, timestamp])
  @@index([storeId, timestamp])
  @@index([companyId, timestamp])
  @@map("time_clock_entries")
}

// =====================================================================
// DOCUMENTOS DO FUNCIONÁRIO (atestado, comprovante de horas, etc.)
// =====================================================================

enum EmployeeDocumentType {
  MEDICAL_CERTIFICATE // atestado médico
  HOURS_PROOF // comprovante de horas
  ABSENCE_JUSTIFICATION // justificativa de falta
  OTHER
}

enum EmployeeDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DocumentAnalysisVerdict {
  /// Nada chamou atenção — ainda assim precisa de decisão humana.
  LOOKS_ROUTINE
  /// Algo merece conferência: data divergente, ilegível, duplicado.
  NEEDS_ATTENTION
  /// A análise não pôde ser feita (arquivo ilegível, provedor fora do ar).
  INCONCLUSIVE
}

/// Documento enviado pelo funcionário e conferido pelo dono ou gerente.
///
/// A análise automática é ADVISORY: ela extrai dados e levanta pontos de
/// atenção, nunca aprova nem reprova sozinha. Detectar falsificação de
/// atestado exige verificar com a fonte emissora, o que nenhum modelo faz —
/// e uma recusa automática indevida tem consequência trabalhista real.
model EmployeeDocument {
  id        String  @id @default(uuid())
  companyId String
  storeId   String?

  userId String
  user   User   @relation("EmployeeDocumentOwner", fields: [userId], references: [id])

  type        EmployeeDocumentType
  title       String
  description String?

  /// Período coberto pelo documento (ex.: dias de afastamento do atestado).
  referenceStart DateTime?
  referenceEnd   DateTime?

  fileName       String
  fileMimeType   String
  fileSizeBytes  Int
  /// Caminho relativo no armazenamento — nunca uma URL pública.
  fileStorageKey String
  /// SHA-256 do conteúdo: identifica reenvio do mesmo arquivo.
  fileChecksum   String

  status EmployeeDocumentStatus @default(PENDING_REVIEW)

  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?     @relation("EmployeeDocumentReviewer", fields: [reviewedById], references: [id])
  reviewComment String?

  /// Parecer automático — sugestão, não decisão.
  analysisVerdict   DocumentAnalysisVerdict?
  analysisSummary   String?
  /// Pontos de atenção levantados pela análise, um por item.
  analysisFindings  String[]
  /// Dados extraídos (datas, CRM, emitente) para o revisor não redigitar.
  analysisExtracted Json?
  analyzedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([userId, createdAt])
  @@index([fileChecksum])
  @@map("employee_documents")
}

// =====================================================================
// AUDITORIA — IMUTÁVEL
// =====================================================================

/// IMUTÁVEL — ver migração de trava a nível de banco (lock_immutable_tables).
model AuditLog {
  id String @id @default(uuid())

  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  storeId        String?
  store          Store?   @relation(fields: [storeId], references: [id])
  posStationId   String?
  cashRegisterId String?
  deviceId       String?

  userId           String?
  user             User?   @relation(fields: [userId], references: [id])
  userRoleSnapshot String? // perfil no momento da ação (role pode mudar depois)
  sessionId        String?

  ipAddress String?
  userAgent String?

  action       AuditAction
  entityType   String?
  entityId     String?
  previousData Json?
  newData      Json?
  reason       String?
  result       AuditResult
  metadata     Json?

  createdAt DateTime @default(now()) // único carimbo — sem updatedAt

  @@index([companyId, createdAt])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =====================================================================
// CONFIGURAÇÃO
// =====================================================================

model AppSetting {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  key         String
  value       Json
  description String?
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@map("app_settings")
}

model StoreSetting {
  id          String  @id @default(uuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id])
  key         String
  value       Json
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@map("store_settings")
}

model DeviceSetting {
  id          String  @id @default(uuid())
  deviceId    String
  device      Device  @relation(fields: [deviceId], references: [id])
  key         String
  value       Json
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, key])
  @@map("device_settings")
}

// =====================================================================
// CATÁLOGO — PRODUTOS, VARIAÇÕES E GRADE DE TAMANHOS (Fase 3)
// =====================================================================

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  TRANSFERENCIA_SAIDA
  TRANSFERENCIA_ENTRADA
  VENDA
  DEVOLUCAO
  INVENTARIO
  PERDA
}

enum StockTransferStatus {
  RASCUNHO
  EM_TRANSITO
  RECEBIDA
  CANCELADA
}

enum InventoryStatus {
  ABERTO
  CONTANDO
  FECHADO
  CANCELADO
}

model Category {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Hierarquia simples: "Anéis" > "Anéis de compromisso". Um nível de pai
  /// basta para a operação da loja e evita árvores que ninguém consegue
  /// navegar no tablet.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  code     String
  name     String
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@map("categories")
}

/// Grade de tamanhos — hoje só de anel, mas o modelo não é específico de anel
/// porque pulseira e corrente também vêm em tamanhos.
model SizeGrade {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code     String
  name     String
  /// Tamanhos na ordem em que a loja fala deles: ["8","9",...,"30"].
  /// Array em vez de tabela filha: a grade é lida inteira, sempre, e nunca
  /// referenciada linha a linha.
  sizes    String[]
  isActive Boolean  @default(true)

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, code])
  @@map("size_grades")
}

model Product {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  /// Grade de tamanhos quando o produto tem numeração (anel, pulseira).
  /// Nulo para o que não tem tamanho, como um pingente.
  sizeGradeId String?
  sizeGrade   SizeGrade? @relation(fields: [sizeGradeId], references: [id])

  sku         String
  name        String
  description String?

  /// Teor do metal. Prata 925 é o padrão da rede; o campo existe porque
  /// folheado e ouro entram no mostruário e não podem ser vendidos como prata.
  material    String   @default("PRATA_925")
  /// Peso em gramas. Decimal, não float: prata é vendida por peso e um erro de
  /// arredondamento aqui vira diferença de dinheiro.
  weightGrams Decimal? @db.Decimal(10, 3)

  costPrice Decimal @default(0) @db.Decimal(12, 2)
  salePrice Decimal @default(0) @db.Decimal(12, 2)

  /// Foto da peça.
  ///
  /// O arquivo fica fora da raiz web, como os documentos: o download passa
  /// pela API para a permissão ser conferida. Guardar só a chave (e não o
  /// binário no banco) mantém o dump de backup no tamanho do texto.
  /// Identificador da peça no serviço de onde ela veio (a variação, na
  /// Nuvemshop).
  ///
  /// É por ele que a importação reencontra a mesma peça na vez seguinte. Sem
  /// isso, a única chave seria o SKU — e a loja virtual não preenche SKU, o
  /// que faria cada importação criar tudo de novo.
  externalId String?

  imageStorageKey String?
  imageMimeType   String?
  /// Foto que mora na loja virtual, trazida junto com o produto importado.
  ///
  /// Guardar o endereço em vez do arquivo é o que torna a importação viável
  /// aqui: as fotos já estão publicadas na Nuvemshop, e baixá-las encheria o
  /// disco do servidor — que, no plano gratuito, é apagado a cada publicação.
  /// Vale enquanto a peça existir lá; foto enviada por aqui tem precedência.
  imageExternalUrl String?
  /// SHA-256 do arquivo — serve de etiqueta de cache no navegador. Sem ele, a
  /// foto trocada continuaria aparecendo a antiga até alguém limpar o cache.
  imageChecksum   String?

  /// Produto com variação não é vendido direto: quem sai do estoque é a
  /// variação (o anel tamanho 18, não "o anel").
  hasVariations Boolean @default(false)
  isActive      Boolean @default(true)

  variations ProductVariation[]
  stockItems StockItem[]
  saleItems  SaleItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, sku])
  /// Uma peça de lá é uma peça aqui: importar duas vezes atualiza, não duplica.
  @@unique([companyId, externalId])
  @@index([companyId, categoryId])
  @@index([companyId, name])
  @@map("products")
}

model ProductVariation {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  companyId String

  sku        String
  /// O tamanho desta variação dentro da grade do produto ("18").
  size       String?
  /// Outros atributos que distinguem a variação: cor da pedra, acabamento.
  attributes Json?

  /// Preço próprio quando esta variação custa diferente do produto — anel
  /// tamanho 30 leva mais prata que o 12. Nulo herda o preço do produto.
  costPriceOverride Decimal? @db.Decimal(12, 2)
  salePriceOverride Decimal? @db.Decimal(12, 2)
  weightGrams       Decimal? @db.Decimal(10, 3)

  barcode  String?
  isActive Boolean @default(true)

  stockItems StockItem[]
  saleItems  SaleItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, sku])
  @@unique([productId, size])
  @@index([barcode])
  @@map("product_variations")
}

// =====================================================================
// ESTOQUE POR LOJA (Fase 3)
// =====================================================================

/// Saldo de um produto (ou variação) numa loja.
///
/// O saldo vive aqui, mas a VERDADE é a soma dos movimentos: esta tabela é o
/// acumulado, mantido na mesma transação de cada StockMovement. Separar as
/// duas coisas permite auditar divergência — se o acumulado não bate com a
/// soma dos movimentos, houve bug ou escrita fora do caminho.
model StockItem {
  id        String @id @default(uuid())
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id])

  quantity         Int @default(0)
  /// Peças separadas para reserva de cliente. O saldo disponível para venda é
  /// `quantity - reservedQuantity`, nunca `quantity`.
  reservedQuantity Int @default(0)
  /// Abaixo disso a tela avisa. Zero desliga o aviso.
  minQuantity      Int @default(0)

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId, variationId])
  @@index([companyId, storeId])
  @@index([productId])
  @@map("stock_items")
}

/// IMUTÁVEL — todo movimento de estoque é append-only, como a auditoria.
///
/// Corrigir um erro de contagem é lançar um AJUSTE novo, com motivo, nunca
/// alterar o movimento anterior. Sem isso ninguém reconstrói por que o saldo é
/// o que é, e desvio de peça vira palavra contra palavra.
model StockMovement {
  id        String @id @default(uuid())
  companyId String
  storeId   String

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  type     StockMovementType
  /// Positivo entra, negativo sai. O sinal é redundante com o `type` de
  /// propósito: a soma da coluna reconstrói o saldo sem interpretar o enum.
  quantity Int

  quantityBefore Int
  quantityAfter  Int

  unitCost Decimal? @db.Decimal(12, 2)

  /// De onde veio o movimento: venda, transferência, inventário. Fica solto
  /// (sem FK) porque a origem pode ser de um módulo que ainda não existe.
  referenceType String?
  referenceId   String?

  reason String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  transferId String?
  transfer   StockTransfer? @relation(fields: [transferId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([storeId, createdAt])
  @@index([stockItemId, createdAt])
  @@map("stock_movements")
}

model StockTransfer {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  fromStoreId String
  fromStore   Store  @relation("TransferOrigin", fields: [fromStoreId], references: [id])
  toStoreId   String
  toStore     Store  @relation("TransferDestination", fields: [toStoreId], references: [id])

  code   String
  status StockTransferStatus @default(RASCUNHO)

  /// A peça sai do estoque da origem quando a transferência PARTE e entra no
  /// destino quando é RECEBIDA. Entre os dois momentos ela não está em nenhuma
  /// loja — é isso que EM_TRANSITO representa, e é onde peça some se ninguém
  /// confere no recebimento.
  sentAt       DateTime?
  sentById     String?
  receivedAt   DateTime?
  receivedById String?

  cancelledAt  DateTime?
  cancelReason String?

  notes String?

  items     StockTransferItem[]
  movements StockMovement[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([fromStoreId, status])
  @@index([toStoreId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id])

  productId   String
  variationId String?

  quantitySent     Int
  /// Preenchido só no recebimento. Diferente do enviado = divergência, que a
  /// tela precisa mostrar em vez de aceitar em silêncio.
  quantityReceived Int?

  createdAt DateTime @default(now())

  @@index([transferId])
  @@map("stock_transfer_items")
}

/// Inventário (contagem) — cego por padrão.
///
/// Quem conta não vê o saldo do sistema. Ver o número esperado antes de contar
/// enviesa a contagem: a tendência é "achar" exatamente o que o sistema diz, e
/// a diferença que deveria aparecer some.
model Inventory {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])

  code    String
  status  InventoryStatus @default(ABERTO)
  /// Contagem cega. Abrir uma contagem não-cega é ato do dono, e fica auditado.
  isBlind Boolean         @default(true)

  startedAt   DateTime  @default(now())
  startedById String
  closedAt    DateTime?
  closedById  String?

  notes String?

  counts InventoryCount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([storeId, status])
  @@map("inventories")
}

model InventoryCount {
  id          String    @id @default(uuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  productId   String
  variationId String?

  /// Saldo que o sistema tinha no momento do fechamento. Gravado no
  /// fechamento, não na contagem — antes disso o contador não pode vê-lo.
  systemQuantity  Int?
  countedQuantity Int

  countedById String
  countedAt   DateTime @default(now())

  @@unique([inventoryId, productId, variationId])
  @@index([inventoryId])
  @@map("inventory_counts")
}

// =====================================================================
// CLIENTES, CAIXA E VENDA (Fase 4)
// =====================================================================

enum CashSessionStatus {
  ABERTO
  FECHADO
}

enum CashMovementType {
  ABERTURA
  SANGRIA
  SUPRIMENTO
  VENDA
  DEVOLUCAO
  FECHAMENTO
}

enum SaleStatus {
  RASCUNHO
  CONCLUIDA
  CANCELADA
  DEVOLVIDA
}

enum PaymentMethod {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  CREDITO_PARCELADO
  TRANSFERENCIA
  CREDIARIO
}

enum ReservationStatus {
  ATIVA
  CONVERTIDA
  CANCELADA
  EXPIRADA
}

enum QuoteStatus {
  ABERTO
  CONVERTIDO
  RECUSADO
  EXPIRADO
}

model Customer {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name  String
  /// Telefone é a chave prática de identificação no balcão: é o que o cliente
  /// sabe de cabeça e o que o vendedor digita. CPF é opcional porque exigi-lo
  /// para uma venda de R$ 60 trava o atendimento sem necessidade.
  phone String
  cpf   String?
  email String?

  birthDate   DateTime?
  /// Tamanho de anel do cliente — a loja pergunta uma vez e usa nas próximas.
  ringSize    String?
  addressJson Json?
  notes       String?

  isActive Boolean @default(true)

  sales         Sale[]
  reservations  Reservation[]
  quotes        Quote[]
  serviceOrders ServiceOrder[]
  pieceRequests PieceRequest[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  /// Telefone único por empresa: dois cadastros do mesmo cliente espalham o
  /// histórico de compra em dois lugares e ninguém vê o cliente inteiro.
  @@unique([companyId, phone])
  @@index([companyId, name])
  @@index([cpf])
  @@map("customers")
}

/// Turno de caixa: da abertura ao fechamento.
///
/// Toda venda pertence a um turno. Sem isso não existe "fechar o caixa" — não
/// haveria como dizer quais vendas o dinheiro da gaveta deveria cobrir.
model CashSession {
  id        String @id @default(uuid())
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  code   String
  status CashSessionStatus @default(ABERTO)

  openedById    String
  openedBy      User     @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  openedAt      DateTime @default(now())
  /// Fundo de troco declarado na abertura.
  openingAmount Decimal  @db.Decimal(12, 2)

  closedById String?
  closedBy   User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime?

  /// O que a pessoa CONTOU na gaveta. Digitado sem ver o esperado — é o
  /// fechamento cego. Ver o número antes de contar faz a diferença sumir.
  countedAmount    Decimal? @db.Decimal(12, 2)
  /// O que o sistema calculou que deveria haver. Gravado só no fechamento,
  /// depois de a contagem estar registrada.
  expectedAmount   Decimal? @db.Decimal(12, 2)
  /// contado - esperado. Negativo é falta.
  differenceAmount Decimal? @db.Decimal(12, 2)
  /// Obrigatória quando há diferença: caixa que não bate precisa de explicação
  /// escrita, não de um botão "confirmar".
  differenceReason String?

  notes String?

  movements CashMovement[]
  sales     Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([cashRegisterId, status])
  @@index([storeId, openedAt])
  @@map("cash_sessions")
}

/// IMUTÁVEL — todo movimento de dinheiro é append-only.
model CashMovement {
  id        String      @id @default(uuid())
  sessionId String
  session   CashSession @relation(fields: [sessionId], references: [id])

  companyId String
  storeId   String

  type   CashMovementType
  /// Positivo entra na gaveta, negativo sai.
  amount Decimal          @db.Decimal(12, 2)

  /// Só movimento em espécie mexe na gaveta. Uma venda no cartão é receita da
  /// loja, mas não é dinheiro para conferir no fechamento — por isso o valor
  /// em espécie da venda é separado do total dela.
  isCash Boolean @default(true)

  reason String?

  referenceType String?
  referenceId   String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([companyId, createdAt])
  @@map("cash_movements")
}

model Sale {
  id        String @id @default(uuid())
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  sessionId String?
  session   CashSession? @relation(fields: [sessionId], references: [id])

  deviceId String?

  sellerId String
  seller   User   @relation("SaleSeller", fields: [sellerId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  code   String
  status SaleStatus @default(RASCUNHO)

  /// Somatório dos itens antes de desconto.
  subtotalAmount Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)

  /// Quem autorizou desconto acima do limite do vendedor.
  discountAuthorizedById String?
  discountAuthorizedBy   User?   @relation("SaleDiscountAuthorizer", fields: [discountAuthorizedById], references: [id])
  discountReason         String?

  notes String?

  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  items    SaleItem[]
  payments SalePayment[]
  returns  SaleReturn[]  @relation("ReturnOriginalSale")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([storeId, createdAt])
  @@index([sellerId, createdAt])
  @@index([customerId])
  @@index([sessionId])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id])

  /// Nome e código congelados no momento da venda. O produto pode ser
  /// renomeado depois, e o comprovante de dois anos atrás precisa continuar
  /// descrevendo o que a pessoa levou.
  productName String
  productSku  String

  quantity       Int
  /// Preço praticado nesta venda. Vem do servidor, nunca do aplicativo.
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  /// Custo congelado, para a margem do relatório não mudar quando o custo do
  /// produto for atualizado.
  unitCostSnapshot Decimal? @db.Decimal(12, 2)

  warranty    Warranty?
  certificate Certificate?
  returnItems SaleReturnItem[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)

  installments Int @default(1)

  /// Maquininha que processou. Obrigatória em cartão: sem ela a conciliação
  /// com a operadora não tem como casar a venda com a transação.
  terminalId String?

  /// Código devolvido pela operadora. Fase 7 preenche automaticamente; até lá
  /// o vendedor digita o que aparece no comprovante da maquininha.
  authorizationCode String?

  /// Quanto o cliente entregou, em dinheiro. Só para calcular o troco.
  tenderedAmount Decimal? @db.Decimal(12, 2)
  changeAmount   Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@map("sale_payments")
}

/// Reserva: peça separada para um cliente, sem ter saído do estoque.
///
/// A peça continua na loja, mas some do saldo disponível — é isso que impede
/// vender duas vezes a mesma aliança que alguém já veio buscar sexta-feira.
model Reservation {
  id        String @id @default(uuid())
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  code   String
  status ReservationStatus @default(ATIVA)

  productId   String
  variationId String?
  quantity    Int     @default(1)

  /// Sinal pago. Fica registrado aqui e vira desconto quando a reserva virar
  /// venda.
  depositAmount Decimal @default(0) @db.Decimal(12, 2)

  /// Prazo. Passou disso, a peça volta para a prateleira — senão o estoque
  /// fica travado por reserva que ninguém veio buscar.
  expiresAt DateTime

  convertedSaleId String?
  cancelReason    String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([storeId, status])
  @@index([customerId])
  @@index([status, expiresAt])
  @@map("reservations")
}

/// Orçamento: aba separada do PDV, sem efeito nenhum sobre o estoque.
model Quote {
  id        String @id @default(uuid())
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  /// Quando o cliente não é cadastrado — orçamento é justamente o momento em
  /// que ele ainda está decidindo.
  customerName  String?
  customerPhone String?

  code   String
  status QuoteStatus @default(ABERTO)

  subtotalAmount Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)

  /// Preço de orçamento não vale para sempre: prata oscila.
  validUntil DateTime

  convertedSaleId String?
  notes           String?

  items QuoteItem[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([storeId, status])
  @@map("quotes")
}

model QuoteItem {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  productId   String
  variationId String?
  productName String
  productSku  String

  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_items")
}

// =====================================================================
// ETIQUETAS E IMPRESSÃO (Fase 5)
// =====================================================================

enum PrintJobStatus {
  NA_FILA
  IMPRIMINDO
  CONCLUIDO
  FALHOU
  CANCELADO
}

enum PrintJobType {
  ETIQUETA
  COMPROVANTE
  FECHAMENTO_CAIXA
}

/// Modelo de etiqueta — dimensões e o que aparece impresso.
///
/// Etiqueta de joia é pequena e vai enrolada na peça ou pendurada. O que cabe
/// nela é pouco: código de barras, preço e um nome curto. Por isso o modelo é
/// um conjunto de opções e não um editor livre — campo demais numa etiqueta de
/// 20 mm sai ilegível, e etiqueta ilegível não é lida no PDV.
model LabelTemplate {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code String
  name String

  /// Em milímetros. A impressora térmica precisa do tamanho exato do rolo.
  widthMm  Decimal @db.Decimal(6, 2)
  heightMm Decimal @db.Decimal(6, 2)

  /// Etiqueta de joia costuma ser dupla: dobra ao meio e as duas metades
  /// ficam coladas na argola. A segunda metade repete o código.
  isDoubleSided Boolean @default(true)

  showProductName Boolean @default(true)
  showSku         Boolean @default(true)
  showPrice       Boolean @default(true)
  showWeight      Boolean @default(false)
  showSize        Boolean @default(true)
  showBarcode     Boolean @default(true)

  /// Ajuste fino de posição, em milímetros. Rolo de etiqueta desalinha com o
  /// uso, e sem isso a impressão sai cortada até alguém trocar a impressora.
  offsetXMm Decimal @default(0) @db.Decimal(6, 2)
  offsetYMm Decimal @default(0) @db.Decimal(6, 2)

  fontScale Decimal @default(1) @db.Decimal(4, 2)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  printJobs PrintJob[]

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("label_templates")
}

/// Fila de impressão.
///
/// A impressão não é feita pelo servidor: quem imprime é o tablet, que está na
/// mesma rede da impressora. O servidor guarda a fila e o resultado. Isso
/// existe porque impressora térmica de balcão falha o tempo todo — acaba
/// papel, perde a rede, trava — e sem fila o funcionário não sabe se a
/// etiqueta saiu, e reimprime até sair errado.
model PrintJob {
  id        String @id @default(uuid())
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  /// Tablet que deve imprimir. Nulo enquanto qualquer um da loja pode pegar.
  deviceId String?

  type   PrintJobType
  status PrintJobStatus @default(NA_FILA)

  templateId String?
  template   LabelTemplate? @relation(fields: [templateId], references: [id])

  /// O conteúdo já resolvido: nome, preço, código de barras. Congelado aqui
  /// para a etiqueta sair com o preço do momento em que foi pedida, e não com
  /// o preço de quando a impressora finalmente respondeu.
  payload Json

  copies Int @default(1)

  /// Origem: produto, venda, fechamento de caixa.
  referenceType String?
  referenceId   String?

  attempts    Int       @default(0)
  lastError   String?
  startedAt   DateTime?
  completedAt DateTime?

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status, createdAt])
  @@index([deviceId, status])
  @@map("print_jobs")
}

// =====================================================================
// COMISSÕES E METAS (Fase 6)
// =====================================================================

enum CommissionBasis {
  /// Percentual sobre o valor vendido.
  FATURAMENTO
  /// Percentual sobre a margem (venda menos custo). Protege a loja de
  /// comissionar venda feita com desconto que comeu o lucro inteiro.
  MARGEM
}

enum GoalPeriod {
  DIARIA
  SEMANAL
  MENSAL
}

enum GoalScope {
  LOJA
  VENDEDOR
}

/// Regra de comissão vigente.
///
/// Versionada por período em vez de editada: a comissão de março precisa
/// continuar sendo calculada pela regra de março, mesmo que a regra mude em
/// abril. Editar no lugar reescreveria o que já foi pago.
model CommissionRule {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Nula = vale para toda a rede. Preenchida = só aquela loja.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])
  /// Nulo = vale para todos os vendedores da abrangência acima.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])

  name  String
  basis CommissionBasis @default(FATURAMENTO)

  percent Decimal @db.Decimal(6, 3)

  /// Só comissiona a partir deste valor vendido no período. Zero desliga.
  minimumSalesAmount Decimal @default(0) @db.Decimal(12, 2)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([storeId, userId])
  @@map("commission_rules")
}

/// Meta de venda — da loja ou de um vendedor.
model Goal {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  scope  GoalScope
  /// Preenchido quando o escopo é VENDEDOR.
  userId String?
  user   User?     @relation(fields: [userId], references: [id])

  period      GoalPeriod
  /// Primeiro dia do período. Guardado como data para o mês de referência ser
  /// inequívoco — "meta de março" e não "meta dos últimos 30 dias".
  periodStart DateTime
  periodEnd   DateTime

  targetAmount Decimal @db.Decimal(12, 2)

  notes String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Uma meta por escopo e período. Duas metas do mesmo vendedor no mesmo mês
  /// fariam o painel mostrar percentuais conflitantes.
  @@unique([storeId, scope, userId, periodStart])
  @@index([companyId, periodStart])
  @@map("goals")
}

// =====================================================================
// GARANTIAS, CERTIFICADOS E TROCAS (Fase 8)
// =====================================================================

enum ReturnType {
  /// Dinheiro de volta.
  DEVOLUCAO
  /// Leva outra peça no lugar. A diferença é cobrada ou devolvida.
  TROCA
}

enum ReturnStatus {
  PENDENTE
  CONCLUIDA
  RECUSADA
}

enum ServiceOrderStatus {
  ABERTA
  EM_ANALISE
  AGUARDANDO_CLIENTE
  EM_REPARO
  PRONTA
  ENTREGUE
  CANCELADA
}

/// Garantia de uma peça vendida.
///
/// Vinculada ao ITEM da venda, não ao produto: a garantia é daquela peça que
/// aquele cliente levou naquele dia. Ligar ao produto faria toda unidade
/// vendida compartilhar um prazo só, o que não significa nada.
model Warranty {
  id        String @id @default(uuid())
  companyId String

  saleItemId String   @unique
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])

  code String

  months    Int
  startsAt  DateTime
  /// Calculada na emissão e congelada. Recalcular na leitura faria o prazo
  /// mudar se alguém corrigisse a data da venda depois.
  expiresAt DateTime

  /// O texto que valia quando a peça foi vendida. Congelado pelo mesmo motivo
  /// do preço no item: mudar os termos depois reescreveria o que foi
  /// prometido ao cliente.
  terms String

  voidedAt   DateTime?
  voidReason String?

  claims WarrantyClaim[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([expiresAt])
  @@map("warranties")
}

/// Acionamento da garantia — o cliente voltou com defeito.
model WarrantyClaim {
  id         String   @id @default(uuid())
  warrantyId String
  warranty   Warranty @relation(fields: [warrantyId], references: [id])

  companyId String
  storeId   String

  description    String
  /// Se o defeito estava coberto. Nulo enquanto ninguém decidiu.
  approved       Boolean?
  decisionReason String?

  /// Ordem de serviço aberta a partir deste acionamento, quando houve reparo.
  serviceOrderId String?

  openedById  String
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warrantyId])
  @@index([companyId, createdAt])
  @@map("warranty_claims")
}

/// Certificado de autenticidade da prata.
///
/// É o papel que o cliente leva junto com a peça atestando o teor do metal.
/// Guardado porque a loja precisa poder reemitir uma segunda via com os mesmos
/// dados — e porque um certificado emitido é uma afirmação da loja sobre o que
/// vendeu.
model Certificate {
  id        String @id @default(uuid())
  companyId String

  saleItemId String?   @unique
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id])

  code String

  productName String
  productSku  String
  material    String
  weightGrams Decimal? @db.Decimal(10, 3)
  /// Descrição livre de pedras, banho, acabamento.
  details     String?

  customerName String?
  issuedAt     DateTime @default(now())

  /// Quantas segundas vias já saíram. Reemissão não gera certificado novo:
  /// dois certificados com códigos diferentes para a mesma peça permitiriam
  /// apresentar dois documentos como se fossem duas peças.
  reissueCount Int @default(0)

  issuedById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, code])
  @@map("certificates")
}

/// Troca ou devolução de uma venda já concluída.
///
/// Não altera a venda original. É um fato novo, com data própria, que aponta
/// para ela — o comprovante que o cliente levou continua valendo, e o caixa do
/// dia em que a peça voltou é o que recebe a saída do dinheiro.
model SaleReturn {
  id        String @id @default(uuid())
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  originalSaleId String
  originalSale   Sale   @relation("ReturnOriginalSale", fields: [originalSaleId], references: [id])

  /// Venda nova gerada pela troca, quando o cliente levou outra peça.
  replacementSaleId String?

  /// Turno em que a devolução aconteceu — não o da venda original.
  sessionId String?

  code   String
  type   ReturnType
  status ReturnStatus @default(PENDENTE)

  /// Quanto voltou para o cliente em dinheiro. Numa troca, é a diferença
  /// quando a peça nova custa menos.
  refundAmount Decimal @default(0) @db.Decimal(12, 2)

  reason String

  /// Quem autorizou. Devolução mexe em dinheiro que já entrou, então precisa
  /// de alguém com a permissão, e o nome fica registrado.
  authorizedById String?

  items SaleReturnItem[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([originalSaleId])
  @@index([storeId, createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id       String     @id @default(uuid())
  returnId String
  return   SaleReturn @relation(fields: [returnId], references: [id])

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])

  quantity     Int
  /// Valor devolvido por este item — o que foi pago por ele, não o preço de
  /// hoje.
  refundAmount Decimal @db.Decimal(12, 2)

  /// Peça danificada não volta para a prateleira. Vai para PERDA, e o motivo
  /// fica no movimento de estoque.
  returnedToStock Boolean @default(true)
  condition       String?

  createdAt DateTime @default(now())

  @@index([returnId])
  @@map("sale_return_items")
}

/// Ordem de serviço — conserto, ajuste de tamanho, banho.
model ServiceOrder {
  id        String @id @default(uuid())
  companyId String
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  code   String
  status ServiceOrderStatus @default(ABERTA)

  /// Peça da loja, quando é de venda própria. Nulo quando o cliente trouxe
  /// uma peça de fora.
  productId String?

  description     String
  /// Estado em que a peça chegou. Descrito na entrada para não virar
  /// discussão na retirada.
  intakeCondition String

  estimatedAmount Decimal? @db.Decimal(12, 2)
  finalAmount     Decimal? @db.Decimal(12, 2)
  /// Coberto pela garantia — nesse caso não se cobra do cliente.
  underWarranty   Boolean  @default(false)

  promisedFor DateTime?
  deliveredAt DateTime?

  notes String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([storeId, status])
  @@index([customerId])
  @@map("service_orders")
}

// =====================================================================
// SOLICITAÇÃO DE PEÇA
// =====================================================================

enum PieceRequestStatus {
  ABERTA
  PROCURANDO
  ENCONTRADA
  AVISADO
  CONCLUIDA
  CANCELADA
}

/// Peça que o cliente pediu e a loja não tinha.
///
/// É o pedido que hoje vira bilhete no caderno e some. Registrado aqui, o
/// cliente é avisado quando a peça chega — e a loja passa a saber o que estão
/// procurando e ela não tem, que é a informação que decide a próxima compra
/// do fornecedor.
model PieceRequest {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])

  code   String
  status PieceRequestStatus @default(ABERTA)

  /// Cliente cadastrado, quando já existe. O nome e o telefone abaixo ficam
  /// gravados de qualquer forma: quem pede uma peça muitas vezes não é
  /// cliente ainda, e obrigar o cadastro completo trava o atendimento.
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String

  /// O que a pessoa pediu, com as palavras dela. Texto livre de propósito:
  /// "aquele anel de coração com pedrinha azul" é o que o cliente sabe dizer,
  /// e forçar a escolha de um produto do catálogo impediria registrar
  /// justamente o que a loja não tem.
  description  String
  /// Peça do catálogo, quando o pedido é de algo que existe mas está em falta.
  productId    String?
  size         String?
  /// Quanto o cliente topa pagar. Ajuda a decidir se vale encomendar.
  budgetAmount Decimal? @db.Decimal(12, 2)

  notes String?

  /// Preenchido quando a peça chega e o cliente é avisado.
  notifiedAt      DateTime?
  /// Venda gerada quando o cliente veio buscar.
  convertedSaleId String?
  cancelReason    String?

  createdById String
  createdBy   User     @relation("PieceRequestCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([storeId, status])
  @@index([customerPhone])
  @@map("piece_requests")
}

// =====================================================================
// INTEGRAÇÕES (Fase 7)
// =====================================================================

enum IntegrationProvider {
  NUVEMSHOP
  MERCADOPAGO
  REDE
}

enum IntegrationStatus {
  DESCONECTADA
  CONECTADA
  ERRO
}

/// Credencial de um serviço externo.
///
/// O token fica CIFRADO em repouso (AES-256-GCM, chave só no ambiente): um
/// dump do banco, sozinho, não dá acesso à conta da loja no Mercado Pago nem
/// na Nuvemshop. É a mesma proteção do segredo de 2FA, pelo mesmo motivo —
/// quem tem o token opera em nome do dono.
model Integration {
  id        String              @id @default(uuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id])
  provider  IntegrationProvider
  status    IntegrationStatus   @default(DESCONECTADA)

  /// Identificador da conta no serviço (loja da Nuvemshop, usuário do MP).
  externalAccountId    String?
  /// AES-256-GCM. NUNCA sai da API — nem para o dono.
  credentialsEncrypted String?

  /// Loja do RS Pratas cujo estoque alimenta o site. Nulo = ainda não escolhida.
  storeId String?

  lastSyncAt    DateTime?
  lastError     String?
  connectedAt   DateTime?
  connectedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events IntegrationEvent[]

  @@unique([companyId, provider])
  @@map("integrations")
}

/// Tudo que chegou de fora, gravado ANTES de ser processado.
///
/// Webhook é a única parte do sistema que não se pode pedir de novo: se o
/// processamento falhar e o evento não tiver sido guardado, o pedido some e
/// ninguém fica sabendo. Guardar primeiro e processar depois torna a falha
/// recuperável — e o externalId impede que a reentrega do mesmo evento vire
/// dois pedidos.
model IntegrationEvent {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  companyId     String

  /// Identificador do evento no serviço externo, quando ele manda um.
  externalId String?
  topic      String
  payload    Json

  processedAt DateTime?
  error       String?
  /// Venda criada a partir deste evento, quando houve.
  saleId      String?

  createdAt DateTime @default(now())

  @@unique([integrationId, externalId])
  @@index([companyId, createdAt])
  @@index([integrationId, processedAt])
  @@map("integration_events")
}

/// Tablet que se apresentou e ainda não foi vinculado a uma loja.
///
/// Existe separado de `Device` porque um aparelho recém-ligado não tem loja
/// nem caixa — e `Device` exige os dois, com razão: um tablet sem loja não
/// pode vender, e afrouxar isso enfraqueceria toda consulta que hoje confia
/// que todo dispositivo pertence a algum lugar.
///
/// Aqui é só a sala de espera. Quando o dono vincula, nasce o `Device` de
/// verdade e esta linha aponta para ele — deixando de aparecer na fila sem
/// perder o histórico de quando o aparelho apareceu pela primeira vez.
model DeviceAnnouncement {
  id String @id @default(uuid())

  /// Identificador do aparelho, gerado pelo Android. É a chave de reencontro:
  /// o mesmo tablet reabrindo o aplicativo cai na mesma linha, em vez de
  /// encher a fila de duplicatas a cada reinício.
  hardwareId String @unique

  model      String?
  osVersion  String?
  appVersion String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  /// Preenchido quando o dono vincula. Some da fila, permanece no histórico.
  deviceId String? @unique

  @@index([deviceId])
  @@map("device_announcements")
}

enum PinResetStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

/// Pedido de PIN temporário.
///
/// Existe para o caso em que o funcionário deixou o PIN vencer e está na porta
/// da loja às 9 da manhã sem conseguir entrar. Sem isto, a saída seria o dono
/// abrir o sistema em outro aparelho e mexer no cadastro — o que ninguém faz
/// com a loja abrindo.
///
/// O pedido é feito da própria tela de login, SEM sessão: quem não consegue
/// entrar não tem sessão para pedir com ela. O que impede abuso é que pedir
/// não concede nada — só o dono ou o gerente aprovam, e a aprovação é
/// registrada com nome.
model PinResetRequest {
  id        String @id @default(uuid())
  companyId String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status PinResetStatus @default(PENDENTE)

  requestedAt DateTime @default(now())
  /// Aparelho de onde o pedido partiu, quando houver.
  deviceId    String?

  decidedAt   DateTime?
  decidedById String?
  /// Motivo da recusa. Quem foi recusado merece saber por quê.
  reason      String?

  @@index([companyId, status])
  @@index([userId, requestedAt])
  @@map("pin_reset_requests")
}
