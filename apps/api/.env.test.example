NODE_ENV=test
PORT=3001
LOG_LEVEL=error

DATABASE_URL=postgresql://app_rw:dev_rw_pw@localhost:5434/rs_pratas_test
DATABASE_MIGRATE_URL=postgresql://app_owner:dev_owner_pw@localhost:5434/rs_pratas_test

REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=test_only_access_secret_min_32_characters_ok
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=rs-pratas-api
REFRESH_TOKEN_PEPPER=test_only_refresh_pepper_min_32_characters

STEP_UP_TOKEN_TTL=5m

# Custo reduzido só no ambiente de teste: a suíte roda dezenas de hashes e o
# valor de produção (19456 KiB) deixaria o CI lento sem ganho de cobertura.
ARGON2_MEMORY_COST=8192
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

TOTP_ISSUER=RS Pratas
TOTP_ENCRYPTION_KEY=test_only_totp_key_min_32_characters_here


# Pasta dos documentos enviados pelos funcionarios (atestados, comprovantes).
# Fora da raiz web: o download passa pela API para checar permissao.
# Precisa entrar na rotina de backup junto com o banco.
DOCUMENT_STORAGE_DIR=./storage/documents-test

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Confiar em X-Forwarded-For para descobrir o IP do cliente. FALSO por padrao:
# sem um proxy real na frente, o cabecalho e forjavel e anula o rate limit por
# IP. Em producao atras de proxy, use o numero de saltos confiaveis (ex.: 1).
TRUST_PROXY=false

RATE_LIMIT_MAX=100000
RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_PER_MINUTE=100000
TWO_FACTOR_RATE_LIMIT_PER_MINUTE=100000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
